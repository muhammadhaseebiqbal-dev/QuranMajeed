<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Header Area -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="6dp">

        <TextView
            android:layout_width="4dp"
            android:layout_height="20dp"
            android:background="@android:color/system_accent1_200" />

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="Daily Hadith | حدیثِ مبارکہ"
            android:textColor="@android:color/system_accent1_100"
            android:textSize="11sp"
            android:letterSpacing="0.03"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- English Content — Full text, no truncation -->
    <TextView
        android:id="@+id/widget_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Loading today's hadith..."
        android:textColor="@android:color/system_neutral1_50"
        android:textSize="11sp"
        android:lineSpacingExtra="2dp" />

    <!-- Urdu Content — Full text, RTL -->
    <TextView
        android:id="@+id/widget_text_ur"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text=""
        android:textColor="@android:color/system_neutral1_200"
        android:textSize="11sp"
        android:lineSpacingExtra="2dp"
        android:gravity="end"
        android:textDirection="rtl"
        android:layout_marginTop="4dp" />

    <!-- Footer Area -->
    <TextView
        android:id="@+id/widget_source"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginTop="4dp"
        android:text="- Source"
        android:textColor="@android:color/system_accent1_200"
        android:textSize="10sp"
        android:textStyle="italic|bold" />

</LinearLayout>
